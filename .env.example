# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# App Secret de tu app de Meta (Configuración > Básica). Verifica que los webhooks sean de Meta.
APP_SECRET=
GRAPH_VERSION=v23.0

# Anthropic Claude API
CLAUDE_API_KEY=
BOT_MODEL=claude-haiku-5-5
BOT_EFFORT=low

# Token de verificación del webhook
VERIFY_TOKEN=

# Tu WhatsApp (formato como lo manda Meta, ej. 5216671234567). Recibe avisos y acepta comandos (#ayuda).
OWNER_PHONE=
# Protege /setup-webhook, /test-claude y /admin/registros (?token=...)
ADMIN_TOKEN=

# Dónde se guardan citas/interesados. En Railway apúntalo a un Volume (ej. /data).
DATA_DIR=
PAUSA_HUMANO_HORAS=12

# Pruebas locales: no envía nada a WhatsApp
DRY_RUN=

PORT=3000
